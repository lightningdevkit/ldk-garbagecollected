	ret_arr = init_uint64_tArray(ret_var.datalen, __LINE__);
	uint64_t *ret_arr_ptr = (uint64_t*)(((uint8_t*)ret_arr) + 8);
	for (size_t g = 0; g < ret_var.datalen; g++) {
		LDKUtxo ret_conv_6_var = ret_var.data[g];
		uint64_t ret_conv_6_ref = 0;
