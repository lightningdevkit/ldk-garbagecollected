jstring  __attribute__((export_name("TS_sign"))) TS_sign(uint8_tArray msg, uint8_tArray sk) {
	LDKu8slice msg_ref;
	msg_ref.datalen = msg->arr_len;
	msg_ref.data = msg->elems;
	uint8_t sk_arr[32];
	CHECK(sk->arr_len == 32);
	memcpy(sk_arr, sk->elems, 32); FREE(sk);
	uint8_t (*sk_ref)[32] = &sk_arr;
	LDKStr ret_str = sign(msg_ref, sk_ref);
	jstring ret_conv = str_ref_to_ts(ret_str.chars, ret_str.len);
	Str_free(ret_str);
	FREE(msg);
	return ret_conv;
}

