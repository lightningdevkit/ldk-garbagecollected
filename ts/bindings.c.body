uint64_t  __attribute__((export_name("TS_get_supportable_anchor_channels"))) TS_get_supportable_anchor_channels(uint64_t context, uint64_tArray utxos) {
	LDKAnchorChannelReserveContext context_conv;
	context_conv.inner = untag_ptr(context);
	context_conv.is_owned = ptr_is_owned(context);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(context_conv);
