uint64_t  __attribute__((export_name("TS_TxIn_new"))) TS_TxIn_new(uint8_tArray witness, uint8_tArray script_sig, uint32_t sequence, uint8_tArray previous_txid, uint32_t previous_vout) {
	LDKWitness witness_ref;
	witness_ref.datalen = witness->arr_len;
	if (witness_ref.datalen > 0) {
		witness_ref.data = MALLOC(witness_ref.datalen * 1, "LDKWitness Bytes");
	} else {
		witness_ref.data = NULL;
	}
	memcpy(witness_ref.data, witness->elems, witness_ref.datalen); FREE(witness);
	witness_ref.data_is_owned = true;
	LDKCVec_u8Z script_sig_ref;
	script_sig_ref.datalen = script_sig->arr_len;
	if (script_sig_ref.datalen > 0) {
		script_sig_ref.data = MALLOC(script_sig_ref.datalen * 1, "LDKCVec_u8Z Bytes");
	} else {
		script_sig_ref.data = NULL;
	}
	memcpy(script_sig_ref.data, script_sig->elems, script_sig_ref.datalen); FREE(script_sig);
	LDKThirtyTwoBytes previous_txid_ref;
	CHECK(previous_txid->arr_len == 32);
	memcpy(previous_txid_ref.data, previous_txid->elems, 32); FREE(previous_txid);
	LDKTxIn* ret_ref = MALLOC(sizeof(LDKTxIn), "LDKTxIn");
	*ret_ref = TxIn_new(witness_ref, script_sig_ref, sequence, previous_txid_ref, previous_vout);
	return tag_ptr(ret_ref, true);
}

