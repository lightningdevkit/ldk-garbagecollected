uint64_t  __attribute__((export_name("TS_verify_signature"))) TS_verify_signature(uint8_tArray signature, uint64_t message, uint8_tArray pubkey) {
	LDKSchnorrSignature signature_ref;
	CHECK(signature->arr_len == 64);
	memcpy(signature_ref.compact_form, signature->elems, 64); FREE(signature);
	LDKTaggedHash message_conv;
	message_conv.inner = untag_ptr(message);
	message_conv.is_owned = ptr_is_owned(message);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(message_conv);
	message_conv = TaggedHash_clone(&message_conv);
	LDKPublicKey pubkey_ref;
	CHECK(pubkey->arr_len == 33);
	memcpy(pubkey_ref.compressed_form, pubkey->elems, 33); FREE(pubkey);
	LDKCResult_NoneSecp256k1ErrorZ* ret_conv = MALLOC(sizeof(LDKCResult_NoneSecp256k1ErrorZ), "LDKCResult_NoneSecp256k1ErrorZ");
	*ret_conv = verify_signature(signature_ref, &message_conv, pubkey_ref);
	TaggedHash_free(message_conv);
	return tag_ptr(ret_conv, true);
}

