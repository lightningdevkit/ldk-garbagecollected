		blinded_hops_conv_12_conv = BlindedHop_clone(&blinded_hops_conv_12_conv);
		blinded_hops_constr.data[m] = blinded_hops_conv_12_conv;
	}
	FREE(blinded_hops);
	LDKBlindedPayInfo payinfo_conv;
	payinfo_conv.inner = untag_ptr(payinfo);
	payinfo_conv.is_owned = ptr_is_owned(payinfo);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(payinfo_conv);
	payinfo_conv = BlindedPayInfo_clone(&payinfo_conv);
	LDKBlindedPaymentPath ret_var = BlindedPaymentPath_from_blinded_path_and_payinfo(introduction_node_id_ref, blinding_point_ref, blinded_hops_constr, payinfo_conv);
