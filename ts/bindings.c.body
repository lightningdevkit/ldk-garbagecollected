	CHECK_INNER_FIELD_ACCESS_OR_NULL(context_conv);
	context_conv = AnchorChannelReserveContext_clone(&context_conv);
	LDKCVec_UtxoZ utxos_constr;
	utxos_constr.datalen = utxos->arr_len;
	if (utxos_constr.datalen > 0)
		utxos_constr.data = MALLOC(utxos_constr.datalen * sizeof(LDKUtxo), "LDKCVec_UtxoZ Elements");
	else
		utxos_constr.data = NULL;
	uint64_t* utxos_vals = utxos->elems;
	for (size_t g = 0; g < utxos_constr.datalen; g++) {
		uint64_t utxos_conv_6 = utxos_vals[g];
		LDKUtxo utxos_conv_6_conv;
		utxos_conv_6_conv.inner = untag_ptr(utxos_conv_6);
		utxos_conv_6_conv.is_owned = ptr_is_owned(utxos_conv_6);
		CHECK_INNER_FIELD_ACCESS_OR_NULL(utxos_conv_6_conv);
		utxos_conv_6_conv = Utxo_clone(&utxos_conv_6_conv);
		utxos_constr.data[g] = utxos_conv_6_conv;
	}
	FREE(utxos);
	LDKChannelManager a_channel_manager_conv;
	a_channel_manager_conv.inner = untag_ptr(a_channel_manager);
	a_channel_manager_conv.is_owned = ptr_is_owned(a_channel_manager);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(a_channel_manager_conv);
	a_channel_manager_conv.is_owned = false;
	LDKChainMonitor chain_monitor_conv;
	chain_monitor_conv.inner = untag_ptr(chain_monitor);
	chain_monitor_conv.is_owned = ptr_is_owned(chain_monitor);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(chain_monitor_conv);
	chain_monitor_conv.is_owned = false;
	jboolean ret_conv = can_support_additional_anchor_channel(&context_conv, utxos_constr, &a_channel_manager_conv, &chain_monitor_conv);
	AnchorChannelReserveContext_free(context_conv);
	return ret_conv;
}

