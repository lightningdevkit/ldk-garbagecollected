	FREE(msg);
	return tag_ptr(ret_conv, true);
}

jboolean  __attribute__((export_name("TS_verify"))) TS_verify(uint8_tArray msg, jstring sig, uint8_tArray pk) {
	LDKu8slice msg_ref;
	msg_ref.datalen = msg->arr_len;
	msg_ref.data = msg->elems;
	LDKStr sig_conv = str_ref_to_owned_c(sig);
	LDKPublicKey pk_ref;
	CHECK(pk->arr_len == 33);
	memcpy(pk_ref.compressed_form, pk->elems, 33); FREE(pk);
	jboolean ret_conv = verify(msg_ref, sig_conv, pk_ref);
	FREE(msg);
	return ret_conv;
}

