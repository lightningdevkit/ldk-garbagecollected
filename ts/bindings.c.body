uint64_t  __attribute__((export_name("TS_create_payment_onion"))) TS_create_payment_onion(uint64_t path, uint8_tArray session_priv, uint64_t total_msat, uint64_t recipient_onion, uint32_t cur_block_height, uint8_tArray payment_hash, uint64_t keysend_preimage, uint64_t invoice_request, uint8_tArray prng_seed) {
	LDKPath path_conv;
	path_conv.inner = untag_ptr(path);
	path_conv.is_owned = ptr_is_owned(path);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(path_conv);
	path_conv = Path_clone(&path_conv);
	uint8_t session_priv_arr[32];
	CHECK(session_priv->arr_len == 32);
	memcpy(session_priv_arr, session_priv->elems, 32); FREE(session_priv);
	uint8_t (*session_priv_ref)[32] = &session_priv_arr;
	LDKRecipientOnionFields recipient_onion_conv;
	recipient_onion_conv.inner = untag_ptr(recipient_onion);
	recipient_onion_conv.is_owned = ptr_is_owned(recipient_onion);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(recipient_onion_conv);
	recipient_onion_conv = RecipientOnionFields_clone(&recipient_onion_conv);
	uint8_t payment_hash_arr[32];
	CHECK(payment_hash->arr_len == 32);
	memcpy(payment_hash_arr, payment_hash->elems, 32); FREE(payment_hash);
	uint8_t (*payment_hash_ref)[32] = &payment_hash_arr;
	void* keysend_preimage_ptr = untag_ptr(keysend_preimage);
	CHECK_ACCESS(keysend_preimage_ptr);
	LDKCOption_ThirtyTwoBytesZ keysend_preimage_conv = *(LDKCOption_ThirtyTwoBytesZ*)(keysend_preimage_ptr);
	keysend_preimage_conv = COption_ThirtyTwoBytesZ_clone((LDKCOption_ThirtyTwoBytesZ*)untag_ptr(keysend_preimage));
	LDKInvoiceRequest invoice_request_conv;
	invoice_request_conv.inner = untag_ptr(invoice_request);
	invoice_request_conv.is_owned = ptr_is_owned(invoice_request);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(invoice_request_conv);
	invoice_request_conv = InvoiceRequest_clone(&invoice_request_conv);
	LDKThirtyTwoBytes prng_seed_ref;
	CHECK(prng_seed->arr_len == 32);
	memcpy(prng_seed_ref.data, prng_seed->elems, 32); FREE(prng_seed);
	LDKCResult_C3Tuple_OnionPacketu64u32ZAPIErrorZ* ret_conv = MALLOC(sizeof(LDKCResult_C3Tuple_OnionPacketu64u32ZAPIErrorZ), "LDKCResult_C3Tuple_OnionPacketu64u32ZAPIErrorZ");
	*ret_conv = create_payment_onion(&path_conv, session_priv_ref, total_msat, &recipient_onion_conv, cur_block_height, payment_hash_ref, keysend_preimage_conv, invoice_request_conv, prng_seed_ref);
	Path_free(path_conv);
	RecipientOnionFields_free(recipient_onion_conv);
	return tag_ptr(ret_conv, true);
}

