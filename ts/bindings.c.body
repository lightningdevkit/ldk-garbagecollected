		counterparty_htlc_sigs_constr.data = MALLOC(counterparty_htlc_sigs_constr.datalen * sizeof(LDKECDSASignature), "LDKCVec_ECDSASignatureZ Elements");
	else
		counterparty_htlc_sigs_constr.data = NULL;
	uint8_tArray* counterparty_htlc_sigs_vals = (void*) counterparty_htlc_sigs->elems;
	for (size_t m = 0; m < counterparty_htlc_sigs_constr.datalen; m++) {
		uint8_tArray counterparty_htlc_sigs_conv_12 = counterparty_htlc_sigs_vals[m];
