	LDKCVec_UtxoZ utxos_constr;
	utxos_constr.datalen = utxos->arr_len;
	if (utxos_constr.datalen > 0)
		utxos_constr.data = MALLOC(utxos_constr.datalen * sizeof(LDKUtxo), "LDKCVec_UtxoZ Elements");
	else
		utxos_constr.data = NULL;
	uint64_t* utxos_vals = utxos->elems;
	for (size_t g = 0; g < utxos_constr.datalen; g++) {
		uint64_t utxos_conv_6 = utxos_vals[g];
		LDKUtxo utxos_conv_6_conv;
		utxos_conv_6_conv.inner = untag_ptr(utxos_conv_6);
		utxos_conv_6_conv.is_owned = ptr_is_owned(utxos_conv_6);
		CHECK_INNER_FIELD_ACCESS_OR_NULL(utxos_conv_6_conv);
		utxos_conv_6_conv = Utxo_clone(&utxos_conv_6_conv);
		utxos_constr.data[g] = utxos_conv_6_conv;
	}
	FREE(utxos);
	uint64_t ret_conv = get_supportable_anchor_channels(&context_conv, utxos_constr);
	AnchorChannelReserveContext_free(context_conv);
	return ret_conv;
}

