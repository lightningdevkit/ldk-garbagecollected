uint64_t  __attribute__((export_name("TS_OffersMessageFlow_new"))) TS_OffersMessageFlow_new(uint8_tArray chain_hash, uint64_t best_block, uint8_tArray our_network_pubkey, uint32_t current_timestamp, uint64_t inbound_payment_key, uint64_t receive_auth_key, uint64_t message_router, uint64_t logger) {
	LDKThirtyTwoBytes chain_hash_ref;
	CHECK(chain_hash->arr_len == 32);
	memcpy(chain_hash_ref.data, chain_hash->elems, 32); FREE(chain_hash);
	LDKBestBlock best_block_conv;
	best_block_conv.inner = untag_ptr(best_block);
	best_block_conv.is_owned = ptr_is_owned(best_block);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(best_block_conv);
	best_block_conv = BestBlock_clone(&best_block_conv);
	LDKPublicKey our_network_pubkey_ref;
	CHECK(our_network_pubkey->arr_len == 33);
	memcpy(our_network_pubkey_ref.compressed_form, our_network_pubkey->elems, 33); FREE(our_network_pubkey);
	LDKExpandedKey inbound_payment_key_conv;
	inbound_payment_key_conv.inner = untag_ptr(inbound_payment_key);
	inbound_payment_key_conv.is_owned = ptr_is_owned(inbound_payment_key);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(inbound_payment_key_conv);
	inbound_payment_key_conv = ExpandedKey_clone(&inbound_payment_key_conv);
	LDKReceiveAuthKey receive_auth_key_conv;
	receive_auth_key_conv.inner = untag_ptr(receive_auth_key);
	receive_auth_key_conv.is_owned = ptr_is_owned(receive_auth_key);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(receive_auth_key_conv);
	receive_auth_key_conv = ReceiveAuthKey_clone(&receive_auth_key_conv);
	void* message_router_ptr = untag_ptr(message_router);
	CHECK_ACCESS(message_router_ptr);
	LDKMessageRouter message_router_conv = *(LDKMessageRouter*)(message_router_ptr);
	if (message_router_conv.free == LDKMessageRouter_JCalls_free) {
		// If this_arg is a JCalls struct, then we need to increment the refcnt in it.
		LDKMessageRouter_JCalls_cloned(&message_router_conv);
	}
	void* logger_ptr = untag_ptr(logger);
	CHECK_ACCESS(logger_ptr);
	LDKLogger logger_conv = *(LDKLogger*)(logger_ptr);
	if (logger_conv.free == LDKLogger_JCalls_free) {
		// If this_arg is a JCalls struct, then we need to increment the refcnt in it.
		LDKLogger_JCalls_cloned(&logger_conv);
	}
	LDKOffersMessageFlow ret_var = OffersMessageFlow_new(chain_hash_ref, best_block_conv, our_network_pubkey_ref, current_timestamp, inbound_payment_key_conv, receive_auth_key_conv, message_router_conv, logger_conv);
	uint64_t ret_ref = 0;
	CHECK_INNER_FIELD_ACCESS_OR_NULL(ret_var);
	ret_ref = tag_ptr(ret_var.inner, ret_var.is_owned);
	return ret_ref;
}

