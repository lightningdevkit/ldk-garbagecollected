		case LDKEvent_OnionMessagePeerConnected: return 25;
		case LDKEvent_PersistStaticInvoice: return 26;
		case LDKEvent_StaticInvoiceRequested: return 27;
		case LDKEvent_FundingTransactionReadyForSigning: return 28;
		default: abort();
	}
