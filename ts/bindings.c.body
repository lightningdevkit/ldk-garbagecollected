uint64_t  __attribute__((export_name("TS_OffersMessageFlow_create_response_for_invoice_request"))) TS_OffersMessageFlow_create_response_for_invoice_request(uint64_t this_arg, uint64_t signer, uint64_t router, uint64_t entropy_source, uint64_t invoice_request, uint64_t amount_msats, uint8_tArray payment_hash, uint8_tArray payment_secret, uint64_tArray usable_channels) {
	LDKOffersMessageFlow this_arg_conv;
	this_arg_conv.inner = untag_ptr(this_arg);
	this_arg_conv.is_owned = ptr_is_owned(this_arg);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(this_arg_conv);
	this_arg_conv.is_owned = false;
	void* signer_ptr = untag_ptr(signer);
	if (ptr_is_owned(signer)) { CHECK_ACCESS(signer_ptr); }
	LDKNodeSigner* signer_conv = (LDKNodeSigner*)signer_ptr;
	void* router_ptr = untag_ptr(router);
	if (ptr_is_owned(router)) { CHECK_ACCESS(router_ptr); }
	LDKRouter* router_conv = (LDKRouter*)router_ptr;
	void* entropy_source_ptr = untag_ptr(entropy_source);
	CHECK_ACCESS(entropy_source_ptr);
	LDKEntropySource entropy_source_conv = *(LDKEntropySource*)(entropy_source_ptr);
	if (entropy_source_conv.free == LDKEntropySource_JCalls_free) {
		// If this_arg is a JCalls struct, then we need to increment the refcnt in it.
		LDKEntropySource_JCalls_cloned(&entropy_source_conv);
	}
	LDKVerifiedInvoiceRequest invoice_request_conv;
	invoice_request_conv.inner = untag_ptr(invoice_request);
	invoice_request_conv.is_owned = ptr_is_owned(invoice_request);
	CHECK_INNER_FIELD_ACCESS_OR_NULL(invoice_request_conv);
	invoice_request_conv = VerifiedInvoiceRequest_clone(&invoice_request_conv);
	LDKThirtyTwoBytes payment_hash_ref;
	CHECK(payment_hash->arr_len == 32);
	memcpy(payment_hash_ref.data, payment_hash->elems, 32); FREE(payment_hash);
	LDKThirtyTwoBytes payment_secret_ref;
	CHECK(payment_secret->arr_len == 32);
	memcpy(payment_secret_ref.data, payment_secret->elems, 32); FREE(payment_secret);
	LDKCVec_ChannelDetailsZ usable_channels_constr;
	usable_channels_constr.datalen = usable_channels->arr_len;
	if (usable_channels_constr.datalen > 0)
		usable_channels_constr.data = MALLOC(usable_channels_constr.datalen * sizeof(LDKChannelDetails), "LDKCVec_ChannelDetailsZ Elements");
	else
		usable_channels_constr.data = NULL;
	uint64_t* usable_channels_vals = usable_channels->elems;
	for (size_t q = 0; q < usable_channels_constr.datalen; q++) {
		uint64_t usable_channels_conv_16 = usable_channels_vals[q];
		LDKChannelDetails usable_channels_conv_16_conv;
		usable_channels_conv_16_conv.inner = untag_ptr(usable_channels_conv_16);
		usable_channels_conv_16_conv.is_owned = ptr_is_owned(usable_channels_conv_16);
		CHECK_INNER_FIELD_ACCESS_OR_NULL(usable_channels_conv_16_conv);
		usable_channels_conv_16_conv = ChannelDetails_clone(&usable_channels_conv_16_conv);
		usable_channels_constr.data[q] = usable_channels_conv_16_conv;
	}
	FREE(usable_channels);
	LDKC2Tuple_OffersMessageCOption_MessageContextZZ* ret_conv = MALLOC(sizeof(LDKC2Tuple_OffersMessageCOption_MessageContextZZ), "LDKC2Tuple_OffersMessageCOption_MessageContextZZ");
	*ret_conv = OffersMessageFlow_create_response_for_invoice_request(&this_arg_conv, signer_conv, router_conv, entropy_source_conv, invoice_request_conv, amount_msats, payment_hash_ref, payment_secret_ref, usable_channels_constr);
	return tag_ptr(ret_conv, true);
}

