		ret_conv_6_ref = tag_ptr(ret_conv_6_var.inner, ret_conv_6_var.is_owned);
		ret_arr_ptr[g] = ret_conv_6_ref;
	}
	
	FREE(ret_var.data);
	return ret_arr;
}

void  __attribute__((export_name("TS_CoinSelection_set_confirmed_utxos"))) TS_CoinSelection_set_confirmed_utxos(uint64_t this_ptr, uint64_tArray val) {
